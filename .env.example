# ---------------------------------------------------------------------------
# ProofRun environment. Copy to .env and fill in. No real values in this file.
# ---------------------------------------------------------------------------

# --- Nebius Token Factory (required) --------------------------------------
# Create a key at https://tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=

# Default/global Token Factory endpoint (OpenAI-compatible).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Nemotron models live in specific regions. If the global endpoint 404s for a
# model, ProofRun falls back to the regional endpoint built from this template.
# Verified regions (see scripts/check-models.js): us-central1, eu-north1, us-north1
NEBIUS_REGIONAL_BASE_URL_TEMPLATE=https://api.tokenfactory.{region}.nebius.com/v1

# --- NVIDIA Nemotron model IDs (verified against Token Factory catalog) ----
# Reasoning tier: audit reasoning + redesign planning.
NEMOTRON_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEMOTRON_REASONING_REGION=us-central1

# Mid tier: HTML/CSS generation, fix cycles.
NEMOTRON_BUILDER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_BUILDER_REGION=us-central1

# Fast tier: classification, extraction, summarization, email drafting.
NEMOTRON_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_FAST_REGION=eu-north1

# Vision tier (optional): reads the before/after screenshots directly.
NEMOTRON_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
NEMOTRON_VISION_REGION=us-north1

# --- Tavily (required for real discovery; demo mode works without it) ------
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# --- Sandbox for running generated code ------------------------------------
# subprocess | openshell   (see DECISIONS.md)
SANDBOX_MODE=subprocess
OPENSHELL_GATEWAY_URL=

# --- App -------------------------------------------------------------------
PORT=3000
# Public base URL of the deployed app, used in mockup preview links.
PUBLIC_BASE_URL=http://localhost:3000
# demo | live  -- demo uses the seeded sample prospect, live hits Tavily.
PROOFRUN_MODE=demo
# Max self-repair attempts after a failed verification run.
PROOFRUN_MAX_RETRIES=3
# Prospects per nightly batch.
PROOFRUN_NIGHTLY_BATCH=4

# --- Send adapters: stubs only. Nothing is ever sent. ----------------------
# Left intentionally empty. ProofRun exports approved drafts; it does not send.
INSTANTLY_API_KEY=
